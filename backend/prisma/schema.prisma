// Prisma Configuration for Office Aid Workplace Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  TEAMS
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EmailFolder {
  INBOX
  STARRED
  SENT
  DRAFTS
  TRASH
}

enum TicketCategory {
  ACCESS_SECURITY
  INFRASTRUCTURE
  SOFTWARE_TOOLS
  FACILITIES
  HR_OPS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  RESOLVED
}

enum NotificationCategory {
  TASKS
  MEETINGS
  EMAILS
  TICKETS
  SYSTEM
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  firstName      String
  lastName       String
  avatarUrl      String?
  role           Role           @default(EMPLOYEE)
  department     String?
  jobTitle       String?
  phone          String?
  location       String?
  presenceStatus PresenceStatus @default(ONLINE)
  skills         String[]       @default([])

  // Org Chart Hierarchy
  managerId    String?
  manager      User?   @relation("OrgChart", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]  @relation("OrgChart")

  // Relations
  authoredAnnouncements Announcement[]
  ownedProjects         Project[]          @relation("ProjectOwner")
  projectMemberships    ProjectMember[]
  assignedTasks         Task[]
  hostedMeetings        Meeting[]          @relation("MeetingHost")
  meetingAttendees      MeetingAttendee[]
  sentEmails            Email[]            @relation("SentEmails")
  receivedEmails        Email[]            @relation("ReceivedEmails")
  requestedTickets      Ticket[]           @relation("TicketRequester")
  assignedTickets       Ticket[]           @relation("TicketAssignee")
  ticketComments        TicketComment[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("Company")
  isPinned  Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  department  String
  status      ProjectStatus @default(ACTIVE)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("Member")

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  orderIndex  Float      @default(0)
  subtasks    Json?      @default("[]")

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model Meeting {
  id          String          @id @default(uuid())
  title       String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  platform    MeetingPlatform @default(GOOGLE_MEET)
  meetingLink String?
  status      MeetingStatus   @default(SCHEDULED)

  hostId String
  host   User   @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)

  attendees MeetingAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetings")
}

model MeetingAttendee {
  id        String  @id @default(uuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String  @default("ACCEPTED")

  @@unique([meetingId, userId])
  @@map("meeting_attendees")
}

model Email {
  id          String      @id @default(uuid())
  senderId    String
  sender      User        @relation("SentEmails", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User        @relation("ReceivedEmails", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  snippet     String?
  category    String?
  folder      EmailFolder @default(INBOX)
  isStarred   Boolean     @default(false)
  isRead      Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("emails")
}

model Ticket {
  id              String         @id @default(uuid())
  ticketNumber    String         @unique
  title           String
  description     String
  category        TicketCategory @default(SOFTWARE_TOOLS)
  priority        Priority       @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  slaDueAt        DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?

  requesterId String
  requester   User   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments TicketComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tickets")
}

model TicketComment {
  id            String   @id @default(uuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message       String
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("ticket_comments")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  NotificationCategory @default(SYSTEM)
  priority  Priority             @default(LOW)
  isRead    Boolean              @default(false)
  actionUrl String?
  createdAt DateTime             @default(now())

  @@map("notifications")
}
