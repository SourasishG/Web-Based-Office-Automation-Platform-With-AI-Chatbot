{
  "info": {
    "_postman_id": "office-aid-api-v1",
    "name": "Office Aid API Service",
    "description": "Postman API Collection for testing Office Aid Workplace Automation Platform backend endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies that the Express API is online and responding."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin - Sourasish Ghosh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('authToken', res.data.token);",
                  "    console.log('✅ AuthToken automatically saved to collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sourasish.ghosh@officeaid.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user, sets cookie, and automatically captures JWT token into {{authToken}}."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Fetches profile of the authenticated user using Bearer token."
          },
          "response": []
        },
        {
          "name": "Register New Team Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"neha.singh@officeaid.com\",\n  \"password\": \"Admin@123\",\n  \"firstName\": \"Neha\",\n  \"lastName\": \"Singh\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Cloud Systems Engineer\",\n  \"role\": \"EMPLOYEE\",\n  \"location\": \"Delhi, India\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new user and issues a JWT token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Clears authentication session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Employee Directory & Org Chart",
      "item": [
        {
          "name": "Get Employee Directory (Roster)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Fetches staff roster with project and task counts."
          },
          "response": []
        },
        {
          "name": "Filter Employees (Department & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees?department=Engineering&search=DevOps",
              "host": ["{{baseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "department", "value": "Engineering" },
                { "key": "search", "value": "DevOps" }
              ]
            },
            "description": "Filters staff by department and search query."
          },
          "response": []
        },
        {
          "name": "Get Employee Headcount & Status Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees/stats",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "stats"]
            },
            "description": "Calculates total headcount, online engagement rate, and department distribution."
          },
          "response": []
        },
        {
          "name": "Get Org Chart Hierarchy Tree",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees/org-chart",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "org-chart"]
            },
            "description": "Returns hierarchical leadership tree (CEO -> VPs -> Specialists)."
          },
          "response": []
        }
      ]
    }
  ]
}
